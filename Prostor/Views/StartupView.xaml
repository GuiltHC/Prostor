<UserControl x:Class="Prostor.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Prostor.Core"
             xmlns:c="clr-namespace:Prostor.Controls">
    <UserControl.Resources>
        <Style x:Key="HoverActions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,0,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Автозагрузка" Style="{StaticResource T.PageTitle}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource T.PageSub}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}" Width="240" Tag="Поиск"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"/>
                <Button Style="{StaticResource Btn.Icon}" core:UI.Glyph="&#xE72C;" Margin="8,0,0,0" ToolTip="Обновить (F5)"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Boot time + hint -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Время загрузки Windows" Style="{StaticResource T.Sec}"/>
                        <TextBlock Text="{Binding BootTitle}" Style="{StaticResource T.Big}" FontSize="26" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding BootNote}" Style="{StaticResource T.Cap}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource T.Cap}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <c:BarChart Grid.Column="1" Width="190" Height="64" VerticalAlignment="Bottom"
                                Values="{Binding BootValues}" Labels="{Binding BootLabels}"
                                Fill="{DynamicResource Brush.AccentSoft}" Highlight="{DynamicResource Brush.Accent}"
                                Visibility="{Binding BootValues, Converter={StaticResource NullVis}}"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource Brush.InfoSoft}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Info}"
                               VerticalAlignment="Top" Margin="0,2,14,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="19"
                               Text="Отключение не удаляет программу — она просто перестанет запускаться при входе. Нужную, но не срочную программу можно запускать через минуту после входа (значок часов): рабочий стол появится быстрее."/>
                </Grid>
            </Border>
        </Grid>

        <!-- Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Style="{StaticResource Seg}" GroupName="sflt" IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=All}" AutomationProperties.Name="Все">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Все"/>
                    <TextBlock Text="{Binding Items.Count}" Opacity="0.55" Margin="6,0,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Seg}" GroupName="sflt" IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Programs}" AutomationProperties.Name="Программы">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Программы"/>
                    <TextBlock Text="{Binding CountPrograms}" Opacity="0.55" Margin="6,0,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Seg}" GroupName="sflt" IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Tasks}" AutomationProperties.Name="Задачи планировщика">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Задачи планировщика"/>
                    <TextBlock Text="{Binding CountTasks}" Opacity="0.55" Margin="6,0,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource Seg}" GroupName="sflt" IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Services}" AutomationProperties.Name="Службы">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Службы"/>
                    <TextBlock Text="{Binding CountServices}" Opacity="0.55" Margin="6,0,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox ItemsSource="{Binding View}" Style="{StaticResource RowList}" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="14,12,0,6">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" FontSize="13"/>
                                        <TextBlock Text="{Binding ItemCount}" Style="{StaticResource T.Cap}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36" Margin="0,0,14,0">
                                    <Border CornerRadius="9" Background="{DynamicResource Brush.SurfaceHigh}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="9" Background="{DynamicResource Brush.Surface}"
                                            Visibility="{Binding Icon, Converter={StaticResource NullVis}}">
                                        <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Border Width="17" Height="17" CornerRadius="9" Background="{DynamicResource Brush.SurfaceHigh}"
                                            BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3"
                                            Visibility="{Binding KindGlyph, Converter={StaticResource NullVis}}">
                                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource T.Icon}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Cap}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               Visibility="{Binding Subtitle, Converter={StaticResource NullVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0" Style="{StaticResource HoverActions}">
                                    <Button Style="{StaticResource Btn.Icon}" core:UI.Glyph="&#xE823;" ToolTip="{Binding DelayMenuText}"
                                            Visibility="{Binding CanDelay, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.ToggleDelayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn.Icon}" core:UI.Glyph="&#xE8A7;" ToolTip="Показать файл в Проводнике"
                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn.Icon}" core:UI.Glyph="&#xE774;" ToolTip="Что это? Найти в интернете"
                                            Command="{Binding DataContext.SearchWebCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="state" Text="{Binding StateText}" Style="{StaticResource T.Cap}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               MinWidth="34" TextAlignment="Right"/>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanModify}"
                                              ToolTip="{Binding LockHint}" ToolTipService.ShowOnDisabled="True"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter TargetName="state" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelayed}" Value="True">
                                    <Setter TargetName="state" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ItemsControl Style="{StaticResource SkeletonRows}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
