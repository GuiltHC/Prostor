<UserControl x:Class="Prostor.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Prostor.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,32">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Очистка" Style="{StaticResource T.PageTitle}"/>
                    <TextBlock Text="Временные файлы и кэши, которые программы создадут заново. Личные файлы, пароли и настройки не затрагиваются."
                               Style="{StaticResource T.PageSub}" MaxWidth="720" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" core:UI.Glyph="&#xE713;" Content="Исключения и расписание" Margin="0,0,8,0"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button core:UI.Glyph="&#xE72C;" Content="Проверить снова" Command="{Binding ScanCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Summary -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.SuccessSoft}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xEA99;" Style="{StaticResource T.Icon}" FontSize="28" Foreground="{DynamicResource Brush.Success}"
                                       Visibility="{Binding IsScanning, Converter={StaticResource BoolVisInv}}"/>
                            <Control Style="{StaticResource Spinner}" Width="30" Height="30" Foreground="{DynamicResource Brush.Success}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Можно освободить" Style="{StaticResource T.Sec}"/>
                        <TextBlock Text="{Binding SelectedText}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource T.Cap}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Primary}" Content="Очистить выбранное" core:UI.Glyph="&#xEA99;" Height="44" Padding="22,0"
                                FontSize="14" Command="{Binding CleanCommand}"/>
                        <Button Style="{StaticResource Btn.Link}" Content="Выбрать всё / снять" HorizontalAlignment="Center" Margin="0,10,0,0"
                                FontSize="12" Command="{Binding SelectAllCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Admin hint -->
            <Border CornerRadius="12" Background="{DynamicResource Brush.WarningSoft}" Padding="18,12" Margin="0,14,0,0"
                    Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Системные категории (обновления Windows, системный TEMP) можно очистить только с правами администратора."/>
                    <Button Grid.Column="2" Content="Перезапустить как администратор" Margin="14,0,0,0"
                            Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Border>

            <!-- Exclusions -->
            <Border CornerRadius="12" Background="{DynamicResource Brush.SurfaceAlt}" Padding="18,10" Margin="0,14,0,0"
                    Visibility="{Binding ExclusionText, Converter={StaticResource NullVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ExclusionText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Windows.old hint -->
            <Border CornerRadius="12" Background="{DynamicResource Brush.InfoSoft}" Padding="18,12" Margin="0,14,0,0"
                    Visibility="{Binding WindowsOldSize, Converter={StaticResource CountVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Info}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding WindowsOldText}"/>
                    <Button Grid.Column="2" Content="Открыть параметры" Margin="14,0,0,0" Command="{Binding OpenWindowsStorageCommand}"/>
                </Grid>
            </Border>

            <!-- Groups -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" Margin="2,0,0,4"/>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Cap}" Margin="2,0,0,4"
                                       Visibility="{Binding Hint, Converter={StaticResource NullVis}}"/>
                            <Border Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" CornerRadius="10" Padding="14,12" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="chk" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                              IsEnabled="{Binding IsLocked, Converter={StaticResource InvBool}}"/>
                                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="17"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2"
                                                                    Visibility="{Binding IsSlow, Converter={StaticResource BoolVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE823;" Style="{StaticResource T.Icon}" FontSize="10"
                                                                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="несколько минут" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,2" Background="{DynamicResource Brush.WarningSoft}"
                                                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="10"
                                                                               Foreground="{DynamicResource Brush.Warning}" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="нужны права администратора" FontSize="11" Foreground="{DynamicResource Brush.Warning}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Cap}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding Warning, Converter={StaticResource NullVis}}">
                                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{DynamicResource Brush.Warning}"
                                                                       VerticalAlignment="Top" Margin="0,2,6,0"/>
                                                            <TextBlock Text="{Binding Warning}" FontSize="11.5" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Grid Grid.Column="3" MinWidth="110" Margin="16,0,4,0" VerticalAlignment="Center">
                                                        <Control Style="{StaticResource Spinner}" Width="18" Height="18" HorizontalAlignment="Right"
                                                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"/>
                                                        <StackPanel HorizontalAlignment="Right" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisInv}}">
                                                            <TextBlock x:Name="size" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Cap}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                                    <Setter TargetName="size" Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
