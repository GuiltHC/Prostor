<UserControl x:Class="Prostor.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Prostor.Core">
    <Grid Margin="36,0,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Журнал" Style="{StaticResource T.PageTitle}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource T.PageSub}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button core:UI.Glyph="&#xE8B7;" Content="Резервные копии" Command="{Binding OpenBackupsCommand}" Margin="0,0,8,0"
                        ToolTip="Папка с копиями удалённых записей реестра и задач"/>
                <Button Style="{StaticResource Btn.Ghost}" core:UI.Glyph="&#xE74D;" Content="Очистить журнал" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Style="{StaticResource Seg}" GroupName="jflt" Content="Всё"
                         IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=All}"/>
            <RadioButton Style="{StaticResource Seg}" GroupName="jflt" Content="Программы"
                         IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Programs}"/>
            <RadioButton Style="{StaticResource Seg}" GroupName="jflt" Content="Очистка"
                         IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Cleanup}"/>
            <RadioButton Style="{StaticResource Seg}" GroupName="jflt" Content="Файлы и папки"
                         IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=Files}"/>
            <RadioButton Style="{StaticResource Seg}" GroupName="jflt" Content="Автозагрузка"
                         IsChecked="{Binding Filter, Converter={StaticResource EqBool}, ConverterParameter=System}"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox ItemsSource="{Binding View}" Style="{StaticResource RowList}" ItemContainerStyle="{StaticResource PlainItem}"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" FontSize="13" Margin="14,14,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Padding="12,9" CornerRadius="10" Background="Transparent" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ic" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
                                        <TextBlock x:Name="gl" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="title" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Cap}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                   ToolTip="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <Button Grid.Column="3" Content="{Binding UndoText}" core:UI.Glyph="&#xE7A7;" Height="30" Margin="16,0,0,0"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="16,0,0,0"
                                            Visibility="{Binding IsUndone, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Отменено" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding TimeText}" Style="{StaticResource T.Cap}" VerticalAlignment="Center"
                                               Margin="16,0,4,0" MinWidth="36" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Accent}" Value="danger">
                                    <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                    <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Accent}" Value="success">
                                    <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                    <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Accent}" Value="warning">
                                    <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.WarningSoft}"/>
                                    <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.SurfaceAlt}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource T.Icon}" FontSize="26" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Border>
                    <TextBlock Text="Пока ничего не происходило" Style="{StaticResource T.H3}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="Удаление программ, очистка, сжатие и перенос папок будут записываться сюда."
                               Style="{StaticResource T.Sec}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="320"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
