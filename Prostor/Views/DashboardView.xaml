<UserControl x:Class="Prostor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Prostor.Core"
             xmlns:c="clr-namespace:Prostor.Controls">
    <UserControl.Resources>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,32">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource T.PageTitle}"/>
                    <TextBlock Text="{Binding SystemText}" Style="{StaticResource T.PageSub}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" core:UI.Glyph="&#xE72C;" Content="Обновить"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Low space warning -->
            <Border CornerRadius="12" Background="{DynamicResource Brush.WarningSoft}" Padding="18,14" Margin="0,0,0,20"
                    Visibility="{Binding DiskTip, Converter={StaticResource NullVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DiskTip}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Stat tiles -->
            <UniformGrid Columns="3" Margin="-8,0,-8,0">
                <Button Style="{StaticResource Btn.Card}" Margin="8" Command="{Binding GoCommand}" CommandParameter="programs">
                    <Grid>
                        <StackPanel>
                            <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xECAA;" Style="{StaticResource T.Icon}" FontSize="19" Foreground="{DynamicResource Brush.Accent}"/>
                            </Border>
                            <TextBlock Text="Установлено" Style="{StaticResource T.Sec}" Margin="0,16,0,0"/>
                            <c:AnimatedText Value="{Binding ProgramsValue}" Format="Number" Style="{StaticResource T.Big}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ProgramsSize}" Style="{StaticResource T.Cap}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource Btn.Card}" Margin="8" Command="{Binding GoCommand}" CommandParameter="cleanup">
                    <Grid>
                        <StackPanel>
                            <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.SuccessSoft}">
                                <TextBlock Text="&#xEA99;" Style="{StaticResource T.Icon}" FontSize="19" Foreground="{DynamicResource Brush.Success}"/>
                            </Border>
                            <TextBlock Text="Можно освободить" Style="{StaticResource T.Sec}" Margin="0,16,0,0"/>
                            <c:AnimatedText Value="{Binding JunkValue}" Format="Size" Placeholder="…" Style="{StaticResource T.Big}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding JunkNote}" Style="{StaticResource T.Cap}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource Btn.Card}" Margin="8" Command="{Binding GoCommand}" CommandParameter="startup">
                    <Grid>
                        <StackPanel>
                            <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.WarningSoft}">
                                <TextBlock Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="19" Foreground="{DynamicResource Brush.Warning}"/>
                            </Border>
                            <TextBlock Text="Автозагрузка" Style="{StaticResource T.Sec}" Margin="0,16,0,0"/>
                            <c:AnimatedText Value="{Binding StartupValue}" Format="Number" Style="{StaticResource T.Big}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding StartupNote}" Style="{StaticResource T.Cap}"/>
                        </StackPanel>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Recommendations -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Что можно сделать" Style="{StaticResource T.H2}"/>
                            <TextBlock Text="Советы по вашему компьютеру — от самого важного" Style="{StaticResource T.Cap}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Можно освободить до" Style="{StaticResource T.Cap}" HorizontalAlignment="Right"/>
                            <c:AnimatedText Value="{Binding RecommendedValue}" Format="Size" FontSize="22" FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" CornerRadius="10" Padding="10,9" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ic" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
                                            <TextBlock x:Name="gl" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Cap}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"/>
                                        <Button Grid.Column="3" Content="{Binding ActionText}" Height="30" MinWidth="100"
                                                Visibility="{Binding ActionText, Converter={StaticResource NullVis}}"
                                                Command="{Binding DataContext.RunRecommendationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="success">
                                        <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                        <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                                        <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.WarningSoft}"/>
                                        <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="danger">
                                        <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                        <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="info">
                                        <Setter TargetName="ic" Property="Background" Value="{DynamicResource Brush.InfoSoft}"/>
                                        <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Drives -->
            <Grid Margin="0,22,0,10">
                <TextBlock Text="Диски" Style="{StaticResource T.H2}"/>
                <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Content="Анализ папки…" core:UI.Glyph="&#xEB05;"
                        Command="{Binding GoCommand}" CommandParameter="analyzer"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Drives}" Margin="-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="8" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Width="86" Height="86">
                                    <c:RingChart x:Name="ring" Value="{Binding UsedFraction}" Thickness="9"
                                                 Track="{DynamicResource Brush.Track}" Fill="{DynamicResource Brush.Accent}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PercentText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="занято" Style="{StaticResource T.Cap}" FontSize="10.5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="14"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource T.Sec}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HealthText, Converter={StaticResource NullVis}}"
                                                ToolTip="{Binding DiskModel}">
                                        <Ellipse x:Name="health" Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource T.Cap}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Format}" Style="{StaticResource T.Cap}" Margin="0,2,0,0"
                                               Visibility="{Binding HealthText, Converter={StaticResource NullVisInv}}"/>
                                    <Button Content="Анализировать" core:UI.Glyph="&#xEB05;" HorizontalAlignment="Left" Height="30" Margin="0,10,0,0"
                                            Command="{Binding DataContext.AnalyzeDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <c:Sparkline Height="34" Values="{Binding History}" Stroke="{DynamicResource Brush.Accent}"
                                                 Visibility="{Binding History, Converter={StaticResource NullVis}}"
                                                 ToolTip="Свободное место за последние 3 месяца"/>
                                    <TextBlock x:Name="forecast" Text="{Binding ForecastText}" Style="{StaticResource T.Cap}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="warn">
                                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="danger">
                                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HealthLevel}" Value="warn">
                                <Setter TargetName="health" Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HealthLevel}" Value="danger">
                                <Setter TargetName="health" Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ForecastLevel}" Value="warn">
                                <Setter TargetName="forecast" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ForecastLevel}" Value="danger">
                                <Setter TargetName="forecast" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Programs overview -->
            <Grid Margin="-8,14,-8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Самые большие программы" Style="{StaticResource T.H3}"/>
                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Content="Все программы"
                                    Command="{Binding GoCommand}" CommandParameter="programs"/>
                        </Grid>
                        <TextBlock Text="Размеры появятся после загрузки списка…" Style="{StaticResource T.Cap}"
                                   Visibility="{Binding TopApps.Count, Converter={StaticResource CountVisInv}}"/>
                        <ItemsControl ItemsSource="{Binding TopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Ghost}" Height="Auto" Padding="8,7" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" Margin="0,0,12,0">
                                                <Border CornerRadius="8" Background="{Binding App.FallbackBrush}">
                                                    <TextBlock Text="{Binding App.Initial}" Foreground="White" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}"
                                                        Visibility="{Binding App.Icon, Converter={StaticResource NullVis}}">
                                                    <Image Source="{Binding App.Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <c:MiniBar Value="{Binding Fraction}" Height="4" Margin="0,6,0,0"
                                                           Fill="{DynamicResource Brush.Accent}" Track="{DynamicResource Brush.Track}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Margin="16,0,0,0" MinWidth="64" TextAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Недавно установленные" Style="{StaticResource T.H3}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding RecentApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Ghost}" Height="Auto" Padding="8,7" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" Margin="0,0,12,0">
                                                <Border CornerRadius="8" Background="{Binding App.FallbackBrush}">
                                                    <TextBlock Text="{Binding App.Initial}" Foreground="White" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}"
                                                        Visibility="{Binding App.Icon, Converter={StaticResource NullVis}}">
                                                    <Image Source="{Binding App.Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource T.Cap}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
