<UserControl x:Class="Prostor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Prostor.Core">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="Margin" Value="4,26,0,10"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource T.Cap}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,0,36,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource T.PageTitle}"/>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.PageSub}"/>

            <!-- Appearance -->
            <TextBlock Text="Оформление" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Left">
                            <TextBlock Text="Тема" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="«Как в системе» переключается вместе с Windows" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Seg}" GroupName="theme" Content="Как в системе"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqBool}, ConverterParameter=system}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="theme" Content="Тёмная"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqBool}, ConverterParameter=dark}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="theme" Content="Светлая"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EqBool}, ConverterParameter=light}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Эффект Mica" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding MicaNote}" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding UseMica}" IsEnabled="{Binding MicaSupported}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Цвет акцента Windows" Style="{StaticResource RowTitle}"/>
                                <Border Width="14" Height="14" CornerRadius="7" Margin="10,1,0,0" Background="{Binding AccentPreview}"/>
                            </StackPanel>
                            <TextBlock Text="Кнопки и выделение будут того же цвета, что выбран в «Параметры → Персонализация → Цвета»" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding UseSystemAccent}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Programs -->
            <TextBlock Text="Удаление программ" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Точка восстановления перед удалением" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}"
                                       Text="Если удаление что-то сломает, систему можно будет откатить. Работает в режиме администратора и при включённой защите системы; Windows создаёт не больше одной точки в сутки."/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding RestorePoint}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Искать остатки после удаления" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Папки, записи реестра, задачи, службы и ярлыки, которые оставил деинсталлятор" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SearchLeftovers}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Left">
                            <TextBlock Text="Считать программу неиспользуемой" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Если её не запускали дольше этого срока — для фильтра «Не используются»" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Seg}" GroupName="unused" Content="3 месяца"
                                         IsChecked="{Binding UnusedMonths, Converter={StaticResource EqBool}, ConverterParameter=3}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="unused" Content="полгода"
                                         IsChecked="{Binding UnusedMonths, Converter={StaticResource EqBool}, ConverterParameter=6}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="unused" Content="год"
                                         IsChecked="{Binding UnusedMonths, Converter={StaticResource EqBool}, ConverterParameter=12}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cleanup -->
            <TextBlock Text="Очистка" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Left">
                            <TextBlock Text="Автоматическая очистка" Style="{StaticResource RowTitle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Seg}" GroupName="auto" Content="Выключена"
                                         IsChecked="{Binding AutoClean, Converter={StaticResource EqBool}, ConverterParameter=off}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="auto" Content="Раз в неделю"
                                         IsChecked="{Binding AutoClean, Converter={StaticResource EqBool}, ConverterParameter=weekly}"/>
                            <RadioButton Style="{StaticResource Seg}" GroupName="auto" Content="Раз в месяц"
                                         IsChecked="{Binding AutoClean, Converter={StaticResource EqBool}, ConverterParameter=monthly}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding AutoCleanStatus}" Style="{StaticResource RowNote}" Margin="0,8,0,0"/>
                    <Button Style="{StaticResource Btn.Link}" Content="Запустить автоочистку сейчас" core:UI.Glyph="&#xE768;" Margin="0,10,0,0"
                            Command="{Binding RunAutoCleanNowCommand}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Left">
                            <TextBlock Text="Исключения" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Эти папки «Простор» никогда не очистит, не удалит и не предложит как остатки" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" core:UI.Glyph="&#xE710;" Content="Добавить папку…"
                                Command="{Binding AddExclusionCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Exclusions}" Margin="0,10,0,0" Visibility="{Binding HasExclusions, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}" Padding="12,6,6,6" Margin="0,0,0,4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Folder}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" core:UI.Glyph="&#xE711;" core:UI.GlyphSize="10"
                                                HorizontalAlignment="Right" ToolTip="Убрать из исключений"
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Integration & updates -->
            <TextBlock Text="Интеграция и обновления" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Меню Проводника" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding ExplorerMenuNote}" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ExplorerMenu}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock Text="Проверять обновления при запуске" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Новые версии берутся из выпусков репозитория на GitHub" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CheckUpdates}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Репозиторий" Style="{StaticResource T.Sec}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Tag="владелец/название, например user/Prostor" MaxWidth="360" HorizontalAlignment="Left"
                                 Width="360" Text="{Binding UpdateRepo, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="2" Content="Проверить сейчас" core:UI.Glyph="&#xE895;" Command="{Binding CheckUpdatesNowCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <TextBlock Text="Горячие клавиши" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.SurfaceHigh}">
                                    <TextBlock Text="{Binding Keys}" FontFamily="Consolas, Segoe UI" FontSize="12"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource T.Sec}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Data -->
            <TextBlock Text="Данные программы" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Настройки, журнал, история дисков и резервные копии" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" core:UI.Glyph="&#xE838;" Content="Открыть папку"
                            Command="{Binding OpenDataFolderCommand}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
