<Window x:Class="Prostor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Prostor.Core"
        xmlns:v="clr-namespace:Prostor.Views"
        xmlns:c="clr-namespace:Prostor.Controls"
        Title="Простор" Width="1320" Height="860" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <StackPanel IsItemsHost="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NavTemplate">
            <Grid ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="gl" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="16" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"/>
                <Border Grid.Column="2" CornerRadius="9" Padding="7,1" Background="{DynamicResource Brush.SurfaceHigh}"
                        Visibility="{Binding Badge, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="gl" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,0,26">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentGradient}">
                        <Grid>
                            <Ellipse Width="20" Height="20" Stroke="#66FFFFFF" StrokeThickness="4.5"/>
                            <Path Stroke="White" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 17,9.25 A 7.75,7.75 0 1 1 9.4,18.3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Width="5" Height="5" Fill="White"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Простор" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="место и программы" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <!-- update available -->
                    <Border CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentBorder}"
                            BorderThickness="1" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding Update, Converter={StaticResource NullVis}}">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Установить" FontSize="12" Margin="22,6,0,0"
                                        Command="{Binding InstallUpdateCommand}"/>
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Icon}" Width="22" Height="22" core:UI.Glyph="&#xE711;" core:UI.GlyphSize="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" ToolTip="Пропустить эту версию"
                                    Command="{Binding DismissUpdateCommand}"/>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding FooterNavItems}" SelectedItem="{Binding SelectedFooterNav}" Style="{StaticResource NavList}"
                             ItemTemplate="{StaticResource NavTemplate}" Margin="0,0,0,10"/>

                    <Border CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EF;" Style="{StaticResource T.Icon}" FontSize="14"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Link}" Content="Перезапустить как администратор" FontSize="12"
                                    Margin="22,6,0,0" Command="{Binding RestartAsAdminCommand}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisInv}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedMainNav}" Margin="12,0"
                         Style="{StaticResource NavList}" ItemTemplate="{StaticResource NavTemplate}"/>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Caption}" core:UI.Glyph="{Binding ThemeGlyph}" core:UI.GlyphSize="13"
                        Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeText}"/>
                <Button Style="{StaticResource Btn.Caption}" core:UI.Glyph="&#xE921;" Click="Minimize_Click" ToolTip="Свернуть"/>
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" core:UI.Glyph="&#xE922;" Click="Maximize_Click" ToolTip="Развернуть"/>
                <Button Style="{StaticResource Btn.CaptionClose}" core:UI.Glyph="&#xE8BB;" Click="Close_Click" ToolTip="Закрыть"/>
            </StackPanel>

            <Grid x:Name="Pages" Grid.Row="1">
                <v:DashboardView x:Name="DashboardPage" DataContext="{Binding Dashboard}"/>
                <v:ProgramsView x:Name="ProgramsPage" DataContext="{Binding Programs}" Visibility="Collapsed"/>
                <v:AnalyzerView x:Name="AnalyzerPage" DataContext="{Binding Analyzer}" Visibility="Collapsed"/>
                <v:CleanupView x:Name="CleanupPage" DataContext="{Binding Cleanup}" Visibility="Collapsed"/>
                <v:StartupView x:Name="StartupPage" DataContext="{Binding Startup}" Visibility="Collapsed"/>
                <v:JournalView x:Name="JournalPage" DataContext="{Binding Journal}" Visibility="Collapsed"/>
                <v:SettingsView x:Name="SettingsPage" DataContext="{Binding Settings}" Visibility="Collapsed"/>
            </Grid>

            <!-- Drop a folder to analyze it -->
            <Border x:Name="DropOverlay" Grid.Row="1" Margin="24,0,24,24" CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource Brush.AccentSoft}">
                <Grid>
                    <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" StrokeDashArray="6 4"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xEB05;" Style="{StaticResource T.Icon}" FontSize="44" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock x:Name="DropText" Text="Отпустите, чтобы проанализировать папку" Style="{StaticResource T.H2}"
                                   Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toast -->
            <Border x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                    Background="{DynamicResource Brush.SurfaceHigh}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                    CornerRadius="10" Padding="16,11,20,11" IsHitTestVisible="False"
                    Visibility="{Binding Toast, Converter={StaticResource NullVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastGlyph" Text="{Binding Toast.Glyph}" FontSize="16" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="warning">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="danger">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Toast.Kind}" Value="info">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Toast.Text}" VerticalAlignment="Center" FontSize="13" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Dialog overlay ============ -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Overlay}"
              Visibility="{Binding Dialog, Converter={StaticResource NullVis}}">
            <Border x:Name="DialogCard" DataContext="{Binding Dialog}" Width="500" MaxHeight="680" Style="{StaticResource Card}" Padding="28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="10" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid HorizontalAlignment="Left">
                            <Border x:Name="dlgIconBg" Width="46" Height="46" CornerRadius="23">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="danger">
                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="success">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="warning">
                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Glyph}" FontSize="20" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisInv}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="danger">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="success">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="warning">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Control Style="{StaticResource Spinner}" Width="24" Height="24"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="18" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Sec}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"
                                   Visibility="{Binding Message, Converter={StaticResource NullVis}}"/>

                        <!-- progress -->
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}">
                            <c:ProgressLine Height="8" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}"
                                            Fill="{DynamicResource Brush.Accent}" Track="{DynamicResource Brush.Track}"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Cap}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ProgressText, Converter={StaticResource NullVis}}"/>
                        </StackPanel>
                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}"
                                Visibility="{Binding ShowOverall, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding OverallText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                <c:ProgressLine Height="4" Margin="0,7,0,0" Value="{Binding OverallProgress}"
                                                Fill="{DynamicResource Brush.Success}" Track="{DynamicResource Brush.Track}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <CheckBox Content="{Binding CheckText}" IsChecked="{Binding CheckValue}" Margin="0,0,0,10"
                                  Visibility="{Binding CheckText, Converter={StaticResource NullVis}}"/>
                        <CheckBox Content="{Binding Check2Text}" IsChecked="{Binding Check2Value}" Margin="0,0,0,10"
                                  Visibility="{Binding Check2Text, Converter={StaticResource NullVis}}"/>
                        <CheckBox Content="{Binding Check3Text}" IsChecked="{Binding Check3Value}" IsEnabled="{Binding Check3Enabled}" Margin="0,0,0,10"
                                  Visibility="{Binding Check3Text, Converter={StaticResource NullVis}}"/>
                        <TextBlock Text="{Binding Footnote}" Style="{StaticResource T.Cap}" TextWrapping="Wrap" Margin="28,-6,0,10"
                                   Visibility="{Binding Footnote, Converter={StaticResource NullVis}}"/>
                        <!-- right to left so the buttons hug the right edge and an extra one wraps to a new line instead of being cut off -->
                        <WrapPanel FlowDirection="RightToLeft">
                            <Button Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" MinWidth="110" IsDefault="True" Margin="0,8,0,0" FlowDirection="LeftToRight"
                                    Visibility="{Binding PrimaryText, Converter={StaticResource NullVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="core:UI.HoverBackground" Value="{DynamicResource Brush.DangerHover}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" MinWidth="100" Margin="10,8,0,0"
                                    FlowDirection="LeftToRight" Visibility="{Binding SecondaryText, Converter={StaticResource NullVis}}"/>
                            <Button Content="{Binding TertiaryText}" Command="{Binding TertiaryCommand}" Style="{StaticResource Btn.Ghost}"
                                    Margin="10,8,0,0" FlowDirection="LeftToRight" Visibility="{Binding TertiaryText, Converter={StaticResource NullVis}}"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Margin="0,16,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                        <ListBox ItemsSource="{Binding Items}" Style="{StaticResource RowList}" MaxHeight="300" Padding="4"
                                 ItemContainerStyle="{StaticResource PlainItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Cap}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Subtitle}"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullVis}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource T.Sec}" VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
